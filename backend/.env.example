# Fanous Backend Configuration
# Copy this to .env and fill in your values

# -- App --
FANOUS_DEBUG=false

# -- Model --
# Options: hf (HuggingFace Transformers) or moon (Moondream Photon)
FANOUS_MODEL_MODE=moon

# API key for Moondream cloud inference (optional)
# Leave empty to use local Photon inference
FANOUS_MOONDREAM_API_KEY=

# HuggingFace token for downloading Moondream2 weights (required if using HF mode)
FANOUS_HF_TOKEN=

# -- Server --
FANOUS_HOST=0.0.0.0
FANOUS_PORT=8000

# -- Inference --
FANOUS_CAPTION_TIMEOUT=80
FANOUS_MAX_FILE_SIZE_MB=20
